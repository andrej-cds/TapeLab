<Window Icon="Assets/icon.png" x:Class="CDSMeasure.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CDS TapeLab" Width="1280" Height="920" MinWidth="1000" MinHeight="760"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource FontBody}" WindowStartupLocation="CenterScreen" WindowState="Maximized">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0" Source="Assets/logo.png" Height="40" Margin="0,0,18,0" RenderOptions.BitmapScalingMode="HighQuality" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="CDS TAPELAB" FontFamily="{StaticResource FontHead}" FontSize="22" Foreground="{StaticResource GoldBrush}" />
                    <TextBlock x:Name="SubText" FontSize="11" Foreground="{StaticResource DimBrush}" />
                </StackPanel>

                <TextBlock Grid.Column="2" x:Name="TitleText" FontFamily="{StaticResource FontHead}" FontSize="22"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />

                <Button Grid.Column="3" x:Name="BackBtn" Style="{StaticResource CdsButton}" Margin="0,0,24,0"
                        Visibility="Collapsed" Click="BackBtn_Click" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="HelpBtn" Style="{StaticResource CdsButton}" Margin="0,0,8,0" Click="HelpBtn_Click" />
                    <Button x:Name="SetBtn" Style="{StaticResource CdsButton}" Margin="0,0,8,0" Click="SetBtn_Click" />
                    <Button x:Name="AboutBtn" Style="{StaticResource CdsButton}" Margin="0,0,8,0" Click="AboutBtn_Click" />
                    <Button x:Name="LicBtn" Style="{StaticResource CdsButton}" Margin="0,0,16,0" Click="LicBtn_Click" />
                    <RadioButton x:Name="LangSl" Style="{StaticResource CdsSeg}" GroupName="lang" Content="SL" Checked="LangSl_Checked" />
                    <RadioButton x:Name="LangEn" Style="{StaticResource CdsSeg}" GroupName="lang" Content="EN" IsChecked="True" Checked="LangEn_Checked" />
                </StackPanel>
            </Grid>
        </Border>

        <ContentControl Grid.Row="1" x:Name="Host" IsTabStop="False" />
    </Grid>
</Window>
