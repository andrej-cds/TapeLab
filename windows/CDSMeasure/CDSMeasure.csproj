<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Če imaš nameščen .NET 8 SDK, spremeni v net8.0-windows -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\CDSTapeLab.ico</ApplicationIcon>
    <AssemblyName>CDSTapeLab</AssemblyName>
    <Product>CDS TapeLab</Product>
    <Version>0.6.0</Version>
    <RootNamespace>CDSMeasure</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\**\*" />
  </ItemGroup>

</Project>
